# Nilai yang diisi di file ini (atau di environment proses) MENANG atas nilai
# yang disimpan lewat CLI (xiao setup / xiao gateway / xiao search / xiao mcp).
# Baris kosong (KEY=) dianggap tidak diisi. Biarkan baris yang dikomentari (#)
# tetap dikomentari untuk pengaturan yang ingin Anda kelola lewat CLI; CLI akan
# memperingatkan bila sebuah nilai di sini menimpa perubahannya.

# ==============================================================================
# Telegram Gateway Configuration
# ==============================================================================

# Telegram Bot Token dari @BotFather (Wajib)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Hard security invariant: hanya Telegram user ID ini yang diizinkan memakai Xiao.
# User ID non-owner akan diabaikan secara senyap (100% dropped).
# Dapat dikonfigurasi via: xiao gateway owner <ID> atau xiao setup.
# Untuk mengaturnya di sini, hapus tanda # dan isi ID Anda.
# OWNER_USER_ID=123456789

# Opsional: daftar grup tempat OWNER_USER_ID boleh memakai bot.
# Kosong = semua grup diizinkan. Jika diisi, grup di luar daftar diabaikan
# (chat pribadi dan workspace khusus selalu diizinkan).
# Di grup biasa Xiao hanya menjawab owner, dan hanya jika di-mention
# (@bot_username), dibalas (reply), atau pesan diawali "/".
# Pisahkan beberapa ID dengan koma (misal: -1001234567890,-1009876543210).
ALLOWED_CHAT_IDS=

# Opsional: ID grup yang dijadikan Dedicated Personal Workspace.
# Di grup ini Xiao menjawab semua pesan owner di semua topik tanpa perlu mention/reply/slash.
# Grup forum (supergroup dengan topik) yang menjadikan bot sebagai admin
# otomatis dianggap workspace khusus walau tidak tercantum di sini.
# Kosongkan secara default; tambahkan ID grup (misal: -1001234567890).
DEDICATED_CHAT_IDS=


# ==============================================================================
# WhatsApp Gateway Configuration
# ==============================================================================

# Aktifkan WhatsApp Gateway (true/false).
# Sesi yang sudah tertaut juga mengaktifkannya secara otomatis.
# WHATSAPP_ENABLED=false

# Nomor pemilik dalam format internasional tanpa tanda plus.
# Contoh: 6281234567890
#
# Pencocokan dilakukan atas nomor telepon, bukan teks JID mentah, sehingga
# tetap bekerja pada akun bermode LID maupun pada JID yang membawa sufiks
# perangkat. Pesan dari nomor lain dibuang tanpa balasan.
# WHATSAPP_OWNER_NUMBER=6281234567890

# Di grup, Xiao hanya menjawab bila di-mention, dibalas, atau pesan diawali "/".
# Grup yang tercantum di sini (JID atau id numerik, dipisah koma) dijawab
# untuk setiap pesan pemilik tanpa perlu mention.
# WHATSAPP_DEDICATED_GROUPS=120363028384910293@g.us

# Jumlah pesan riwayat yang disimpan per chat/topik (0 = tanpa batas).
# Hanya dibaca dari environment/.env.
# XIAO_HISTORY_RETENTION=2000

# Folder data (database, brankas rahasia, lampiran, sesi WhatsApp).
# Bawaan: %APPDATA%\xiaoai di Windows, $XDG_DATA_HOME/xiaoai, atau ~/.local/share/xiaoai.
# XIAO_DATA_DIR=/var/lib/xiaoai


# ==============================================================================
# OpenAI-Compatible AI Provider
# ==============================================================================
# Variabel di bawah berfungsi sebagai auto-seed awal untuk `xiao start` saat database
# masih kosong (memungkinkan zero-prompt headless deployment).
# Bawaan utama: OpenRouter (https://openrouter.ai/api/v1). Pengguna cukup memasukkan
# AI_API_KEY dari https://openrouter.ai/keys untuk langsung menggunakannya.
# Setelah seeded ke SQLite, perubahan provider/model berikutnya dapat dikelola
# secara dinamis via CLI: `xiao ai` atau `xiao setup`.

# URL endpoint API yang kompatibel dengan OpenAI (/v1)
# Bawaan: OpenRouter (https://openrouter.ai/api/v1)
AI_ENDPOINT=https://openrouter.ai/api/v1

# Kunci API untuk otentikasi provider AI (isi dengan API key OpenRouter Anda dari https://openrouter.ai/keys).
# Tidak diperlukan untuk endpoint lokal (localhost/127.0.0.1). Selama nilainya masih
# placeholder YOUR_..., auto-seed dilewati.
AI_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Model utama yang digunakan untuk percakapan di OpenRouter (misal: google/gemini-2.0-flash-001, deepseek/deepseek-chat)
# Jika dikosongkan: google/gemini-2.0-flash-001 untuk OpenRouter, "default" untuk endpoint lain.
AI_MODEL=google/gemini-2.0-flash-001


# ==============================================================================
# Image Generation & Fallback Settings
# ==============================================================================

# Provider fallback image eksternal jika endpoint OpenAI images gagal/tidak didukung.
# Nilai: "none" (default aman) atau "pollinations" (opt-in untuk prompt gambar publik).
IMAGE_FALLBACK_PROVIDER=none


# ==============================================================================
# Network Timeouts (Detik)
# Bilangan bulat detik; nilai di atas 600 dibatasi menjadi 600.
# ==============================================================================

# Connect timeout umum untuk chat completions, capability probe, dan STT
AI_PROVIDER_CONNECT_TIMEOUT_SECS=10

# Connect timeout untuk unduhan payload image
IMAGE_PROVIDER_CONNECT_TIMEOUT_SECS=10

# Timeout proses pembuatan gambar (image generation)
IMAGE_GENERATION_TIMEOUT_SECS=120

# Timeout pengunduhan hasil gambar yang digenerate
IMAGE_DOWNLOAD_TIMEOUT_SECS=30


# ==============================================================================
# Web Search & Tool Calling (Opsional)
# Prioritas pencarian: Brave -> Tavily -> Exa API -> Exa MCP (Keyless) -> DuckDuckGo,
# lalu Wikipedia jika semuanya gagal. Mesin yang baru gagal dilewati beberapa menit.
# ==============================================================================

# API key untuk Brave Search API
BRAVE_API_KEY=

# API key untuk Tavily AI Search API (dapat juga menggunakan TAVILY_KEY)
TAVILY_API_KEY=

# API key untuk Exa AI REST API (dapat juga menggunakan EXA_KEY)
EXA_API_KEY=

# URL endpoint Exa MCP untuk mode keyless (default: https://mcp.exa.ai/)
# EXA_MCP_URL=https://mcp.exa.ai/


# ==============================================================================
# Logging & Debugging (Opsional)
# ==============================================================================

# Filter level log aplikasi (misal: info, debug, warn, xiao=debug)
RUST_LOG=info
